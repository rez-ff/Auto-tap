-- BACKEND: LIVE DISPLAY
--═══════════════════════════════════════════════════════════════════════════
updateLiveDisplay = function()
    local myChar = LP.Character
    if not myChar then
        liveLbl.Text = "⏸️ Character load nahi hua"
        liveLbl.TextColor3 = Color3.fromRGB(180, 160, 100)
        return
    end
    local nearest, dist = getNearestPlayer()
    if not nearest then
        liveLbl.Text = "🔍 Koi player 20 studs me nahi"
        liveLbl.TextColor3 = Color3.fromRGB(180, 180, 200)
        return
    end
    local name = nearest.Name
    local mem = playerMemory[name]
    if not mem then
        liveLbl.Text = "🔍 Koi player 20 studs me nahi"
        liveLbl.TextColor3 = Color3.fromRGB(180, 180, 200)
        return
    end
    if mem.done then
        liveLbl.Text = "✅ " .. name .. " — COMPLETE"
        liveLbl.TextColor3 = Color3.fromRGB(80, 255, 100)
    else
        local distStr = string.format("%.0f", dist)
        liveLbl.Text = "🎯 " .. name .. " — " .. formatTime(mem.time)
            .. " / " .. formatTime(timerTargetSeconds)
            .. " (" .. distStr .. " studs)"
        liveLbl.TextColor3 = Color3.fromRGB(220, 220, 255)
    end
end

--═══════════════════════════════════════════════════════════════════════════
-- BACKEND: TIMER LOOP
--═══════════════════════════════════════════════════════════════════════════
startTimerLoop = function()
    if timerRunning then return end
    timerRunning = true
    timerLoopToken += 1
    local myToken = timerLoopToken
    timerToggleBtn.Text = "⏹ STOP TIMER"
    timerToggleBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
    task.spawn(function()
        while timerRunning and myToken == timerLoopToken do
            local nearest = getNearestPlayer()
            if nearest then
                local name = nearest.Name
                if not playerMemory[name] then
                    playerMemory[name] = { time = 0, done = false }
                end
                local mem = playerMemory[name]
                if not mem.done then
                    mem.time += 0.5
                    if mem.time >= timerTargetSeconds then
                        mem.time = timerTargetSeconds
                        mem.done = true
                        task.spawn(function()
                            startAutoClicking("timer", name)
                            refreshACBtn()
                        end)
                    end
                end
            end
            for name2, mem2 in pairs(playerMemory) do
                if not mem2.done then
                    local isNear = (nearest and nearest.Name == name2)
                    if not isNear then
                        local p2 = Players:FindFirstChild(name2)
                        local myChar2 = LP.Character
                        if p2 and myChar2 then
                            local char2 = p2.Character
                            local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
                            local r2 = char2 and char2:FindFirstChild("HumanoidRootPart")
                            local rm = myChar2:FindFirstChild("HumanoidRootPart")
                            if r2 and rm then
                                local d2 = (r2.Position - rm.Position).Magnitude
                                if d2 > detectionRadius or not hum2 or hum2.Health <= 0 then
                                    mem2.time = 0
                                end
                            else
                                mem2.time = 0
                            end
                        else
                            mem2.time = 0
                        end
                    end
                end
            end
            updateLiveDisplay()
            task.wait(0.5)
        end
    end)
end

stopTimerLoop = function()
    timerRunning = false
    timerLoopToken += 1
    timerToggleBtn.Text = "▶ START TIMER"
    timerToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 80)
    liveLbl.Text = "🔍 Koi player 20 studs me nahi"
    liveLbl.TextColor3 = Color3.fromRGB(180, 180, 200)
end

--═══════════════════════════════════════════════════════════════════════════
-- BACKEND: PLAYER LIST (in-place update — FIX #5)
--═══════════════════════════════════════════════════════════════════════════
local rowCache = {}
local lastSetSig = ""
local lastDoneSig = ""

local function getSetSig()
    local names = {}
    for name in pairs(playerMemory) do names[#names+1] = name end
    table.sort(names)
    return table.concat(names, ",")
end

local function getDoneSig()
    local parts = {}
    for name, mem in pairs(playerMemory) do
        parts[#parts+1] = name .. ":" .. tostring(mem.done)
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

rebuildPlayerList = function()
    local setSig = getSetSig()
    local doneSig = getDoneSig()
    if setSig ~= lastSetSig or doneSig ~= lastDoneSig then
        for _, child in ipairs(listScroll:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
        end
        rowCache = {}
        local activeList, completeList = {}, {}
        for name, mem in pairs(playerMemory) do
            if mem.done then completeList[#completeList+1] = { name = name, mem = mem }
            else activeList[#activeList+1] = { name = name, mem = mem } end
        end
        table.sort(activeList, function(a,b) return a.mem.time > b.mem.time end)
        table.sort(completeList, function(a,b) return a.mem.time > b.mem.time end)
        emptyListLbl.Visible = (#activeList + #completeList) == 0
        local order = 1
        local function addEntry(name, mem)
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 30)
            row.BackgroundColor3 = mem.done and Color3.fromRGB(20, 40, 20) or Color3.fromRGB(28, 14, 48)
            row.BackgroundTransparency = 0.3
            row.BorderSizePixel = 0
            row.LayoutOrder = order
            row.ZIndex = 16
            row.Parent = listScroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)
            local statusLbl = Instance.new("TextLabel")
            statusLbl.Size = UDim2.new(0, 20, 1, 0)
            statusLbl.Position = UDim2.new(0, 4, 0, 0)
            statusLbl.BackgroundTransparency = 1
            statusLbl.Text = mem.done and "✓" or "•"
            statusLbl.TextColor3 = mem.done and Color3.fromRGB(80, 255, 100) or Color3.fromRGB(180, 80, 255)
            statusLbl.Font = Enum.Font.GothamBold
            statusLbl.TextSize = 14
            statusLbl.ZIndex = 17
            statusLbl.Parent = row
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(0, 110, 1, 0)
            nameLbl.Position = UDim2.new(0, 24, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = name
            nameLbl.TextColor3 = Color3.new(1, 1, 1)
            nameLbl.Font = Enum.Font.Gotham
            nameLbl.TextSize = 10
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.ZIndex = 17
            nameLbl.Parent = row
            local timeLbl = Instance.new("TextLabel")
            timeLbl.Size = UDim2.new(0, 80, 1, 0)
            timeLbl.Position = UDim2.new(1, -82, 0, 0)
            timeLbl.BackgroundTransparency = 1
            timeLbl.Text = formatTime(mem.time)
            timeLbl.TextColor3 = mem.done and Color3.fromRGB(80, 255, 100) or Color3.fromRGB(220, 220, 240)
            timeLbl.Font = Enum.Font.Gotham
            timeLbl.TextSize = 10
            timeLbl.TextXAlignment = Enum.TextXAlignment.Right
            timeLbl.ZIndex = 17
            timeLbl.Parent = row
            rowCache[name] = { row = row, timeLbl = timeLbl, statusLbl = statusLbl }
            order += 1
        end
        for _, e in ipairs(activeList) do addEntry(e.name, e.mem) end
        for _, e in ipairs(completeList) do addEntry(e.name, e.mem) end
        lastSetSig = setSig
        lastDoneSig = doneSig
    else
        for name, mem in pairs(playerMemory) do
            local r = rowCache[name]
            if r and r.timeLbl then r.timeLbl.Text = formatTime(mem.time) end
        end
    end
end

task.spawn(function()
    while SG.Parent do
        pcall(rebuildPlayerList)
        task.wait(1)
    end
end)

