-- TOGGLE FUNCTION
--═══════════════════════════════════════════════════════════════════════════
local open = false
local animating = false

toggle = function()
    if animating then return end
    animating = true
    open = not open
    if open then
        MF.Visible = true
        MF.Size = UDim2.new(0, 280, 0, 0)
        TweenService:Create(MF, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 280, 0, panelHeight)
        }):Play()
        TweenService:Create(TBStroke, TweenInfo.new(0.3), {
            Color = Color3.fromRGB(255, 215, 0), Transparency = 0
        }):Play()
        task.wait(0.4)
    else
        TweenService:Create(MF, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 280, 0, 0)
        }):Play()
        TweenService:Create(TBStroke, TweenInfo.new(0.3), {
            Color = Color3.fromRGB(131, 56, 236), Transparency = 0.6
        }):Play()
        task.wait(0.3)
        MF.Visible = false
    end
    animating = false
end

CloseBtn.MouseButton1Click:Connect(function()
    if open then toggle() end
end)

-- Header drag
local menuDrag = false
local menuStart, menuStartPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        menuDrag = true
        menuStart = input.Position
        menuStartPos = MF.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if menuDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - menuStart
        MF.Position = UDim2.new(
            menuStartPos.X.Scale, menuStartPos.X.Offset + delta.X,
            menuStartPos.Y.Scale, menuStartPos.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        menuDrag = false
    end
end)

