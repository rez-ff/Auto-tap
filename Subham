local function makeBtn(parent, text, size, bg, layoutOrder)
    local b = Instance.new("TextButton")
    b.Size = size or UDim2.new(1, 0, 0, 28)
    b.BackgroundColor3 = bg or Color3.fromRGB(80, 50, 160)
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.LayoutOrder = layoutOrder or 1
    b.ZIndex = 14
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), { BackgroundTransparency = 0.2 }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
    end)
    return b
end

