-- Top bar drag + tap
local tbDragging = false
local tbDragStart, tbStartPos
local tbPressTime = 0
local tbWasDragged = false

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        tbDragging = true
        tbDragStart = input.Position
        tbStartPos = TopBar.Position
        tbPressTime = tick()
        tbWasDragged = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if tbDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - tbDragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            tbWasDragged = true
            TopBar.Position = UDim2.new(
                tbStartPos.X.Scale, tbStartPos.X.Offset + delta.X,
                tbStartPos.Y.Scale, tbStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if tbDragging then
            local holdTime = tick() - tbPressTime
            if not tbWasDragged and holdTime < 0.5 then
                if toggle then toggle() end
            end
            tbDragging = false
            tbWasDragged = false
        end
    end
end)

