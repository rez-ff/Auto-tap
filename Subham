-- BACKEND: AUTO CLICKER (bug-fixed)
--═══════════════════════════════════════════════════════════════════════════
refreshACBtn = function()
    if clicking then
        acToggleBtn.Text = "⏹ STOP CLICKING"
        acToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    else
        acToggleBtn.Text = "▶ START CLICKING"
        acToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 60)
    end
end

startAutoClicking = function(source, targetName)
    if clicking then return end
    if not clickTargetBox or not clickTargetBox.Parent then return end -- FIX #1
    clicking = true
    clickToken += 1
    local myToken = clickToken
    autoClickSource = source or "manual"
    autoClickTarget = targetName
    task.spawn(function()
        while clicking and myToken == clickToken do
            if not clickTargetBox or not clickTargetBox.Parent then -- FIX #1
                clicking = false; refreshACBtn(); break
            end
            if autoClickSource == "timer" and autoClickTarget then -- FIX #2
                local shouldStop = false
                local targetP = Players:FindFirstChild(autoClickTarget)
                if not targetP then
                    shouldStop = true
                else
                    local tChar = targetP.Character
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    if not tHum or tHum.Health <= 0 or not tRoot then
                        shouldStop = true
                    else
                        local myChar = LP.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if not myRoot then
                            shouldStop = true
                        elseif (tRoot.Position - myRoot.Position).Magnitude > detectionRadius then
                            shouldStop = true
                        end
                    end
                end
                if shouldStop then
                    clicking = false; refreshACBtn(); break
                end
            end
            local ok, err = pcall(doVIMClick, clickTargetBox)
            if not ok then
                warn("[AutoClicker] " .. tostring(err))
                clicking = false; refreshACBtn(); break
            end
            task.wait(math.clamp(1 / cps, 0.02, 1))
        end
    end)
end

stopAutoClicking = function()
    clicking = false
    clickToken += 1
    autoClickSource = nil
    autoClickTarget = nil
end

--═══════════════════════════════════════════════════════════════════════════
-- BACKEND: NEAREST PLAYER (health-checked)
--═══════════════════════════════════════════════════════════════════════════
local function getNearestPlayer()
    local myChar = LP.Character
    if not myChar then return nil, nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil end
    local nearest = nil
    local nearestDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local char = p.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then -- FIX #6
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist <= detectionRadius and dist < nearestDist then
                        nearestDist = dist
                        nearest = p
                    end
                end
            end
        end
    end
    return nearest, nearestDist
end

