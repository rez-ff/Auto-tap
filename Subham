-- BACKEND: VIM CLICK (with calibration offset)
--═══════════════════════════════════════════════════════════════════════════
local function doVIMClick(frame)
    if not frame or not frame.Parent then return end
    local xOff = tonumber(xBox.Text) or 0
    local yOff = tonumber(yBox.Text) or 0
    local pos = frame.AbsolutePosition
    local size = frame.AbsoluteSize
    local x = pos.X + size.X / 2 + xOff
    local y = pos.Y + size.Y / 2 + yOff
    synToken += 1
    local t = synToken
    synthetic = true
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    task.delay(0.06, function()
        if synToken == t then synthetic = false end
    end)
end

